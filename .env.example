# Copy this file to .env.local, fill in the values, and never commit .env.local.
# Restart the site after changing it.

# Password for the admin page at /admin, where reviews are approved. At least 10 characters;
# the admin page stays switched off until it is set. Changing it logs out every admin session.
ADMIN_PASSWORD=

# Any long random text. Keeps the review spam limits working across restarts of the site.
# Make one in PowerShell with: -join (1..32 | % { '{0:x2}' -f (Get-Random -Max 256) })
REVIEWS_SECRET=

# Optional: where the reviews database is stored (default: data/family-time.db).
# REVIEWS_DB_PATH=

# Add API keys here later (maps, events).
